{
  "name": "@overpunch/sanity-convert-ids-to-slugs",
  "version": "2.0.2",
  "description": "Convert document IDs to slug-based IDs in Sanity Studio with automatic reference updating",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "esbuild src/index.jsx --bundle=true --format=esm --jsx=automatic --external:react --external:react-dom --external:sanity --external:@sanity/* --outfile=dist/index.js",
    "capture": "node scripts/capture.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sanity",
    "sanity-studio",
    "sanity-plugin",
    "slug",
    "id-conversion",
    "batch-processing",
    "content-management",
    "cms",
    "utility",
    "developer-tools"
  ],
  "author": "Quinn Keaveney <hello@liiift.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liiift-Studio/sanity-convert-ids-to-slugs.git"
  },
  "bugs": {
    "url": "https://github.com/Liiift-Studio/sanity-convert-ids-to-slugs/issues"
  },
  "homepage": "https://github.com/Liiift-Studio/sanity-convert-ids-to-slugs#readme",
  "peerDependencies": {
    "@sanity/icons": ">=2 <6",
    "@sanity/ui": ">=2 <5",
    "react": "^18.0.0 || ^19.0.0",
    "sanity": ">=3 <7"
  },
  "devDependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.5",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@overpunch/sanity-ui-compat": "^0.1.0"
  }
}
